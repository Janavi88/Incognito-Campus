PORT=3000
# Port 5433 matches the Docker command in the README. Use 5432 only if your PostgreSQL listens there.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/incognito_campus
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=2h
# Python search service (search_service.py). Posting and browsing still work when it is not running.
SEARCH_SERVICE_URL=http://localhost:8001
